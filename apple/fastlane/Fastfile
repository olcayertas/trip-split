# Release lanes for TripSplit. Run through `bundle exec fastlane ios <lane>` from apple/.
# Secrets come from apple/fastlane/.env (git-ignored). This file never prints them.

default_platform(:ios)

APP_ID = "com.olcayertas.TripSplit"
TEAM_ID = "SNZ29V4PJZ"
PROJECT = "TripSplit.xcodeproj"
SCHEME = "TripSplit"
# Lanes run with apple/fastlane/ as the working directory. Ruby file paths start from apple/.
APPLE_DIR = File.expand_path("..", __dir__)
PROJECT_YML = File.join(APPLE_DIR, "project.yml")

platform :ios do
  # Build the ASC API key hash from the env vars. Fails with a clear message, no values.
  def asc_api_key
    missing = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].select { |k| ENV[k].to_s.empty? }
    UI.user_error!("Missing env vars: #{missing.join(', ')}. See fastlane/.env.example.") unless missing.empty?
    key_path = File.expand_path(ENV["ASC_KEY_PATH"])
    UI.user_error!("ASC_KEY_PATH does not point to a file.") unless File.file?(key_path)
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: key_path,
      in_house: false
    )
  end

  desc "Read-only check: the ASC key loads, the app record exists. Prints version and build."
  lane :inspect do
    api_key = asc_api_key
    UI.success("ASC API key loaded.")
    UI.message("Bundle id: #{APP_ID}, team: #{TEAM_ID}")
    begin
      build = latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID, initial_build_number: 0)
      UI.success("Latest TestFlight build: #{build}")
    rescue StandardError => e
      UI.important("Could not read TestFlight builds: #{e.class}. Does the app record exist?")
    end
    if File.exist?(PROJECT_YML)
      version = File.read(PROJECT_YML)[/MARKETING_VERSION:\s*"?([\d.]+)"?/, 1]
      UI.message("Marketing version in project.yml: #{version || 'not found'}")
    else
      UI.important("apple/project.yml not found. The iOS track has not added it yet.")
    end
  end

  # The .xcodeproj is not committed. Make it from project.yml before each build.
  def generate_project
    UI.user_error!("apple/project.yml not found.") unless File.exist?(PROJECT_YML)
    Dir.chdir(APPLE_DIR) { sh("xcodegen", "generate") }
  end

  # The next build number. With no upload yet, the first build is 1.
  def next_build_number(api_key)
    latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID, initial_build_number: 0) + 1
  end

  # Archive with Release and export an App Store .ipa to apple/build/. Uploads nothing.
  def archive_and_export(api_key)
    generate_project
    build_number = next_build_number(api_key)
    UI.message("Next build number: #{build_number}")

    # The archive step needs the auth args. gym adds them to the export step itself, from the loaded API key,
    # and xcodebuild refuses them twice. The build number goes to the archive only.
    auth_args = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{File.expand_path(ENV['ASC_KEY_PATH'])}",
      "-authenticationKeyID #{ENV['ASC_KEY_ID']}",
      "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
    ].join(" ")

    # Sign the export with the local Apple Distribution certificate and an App Store profile. Cloud signing
    # needs a key permission that an App Manager key does not have. get_provisioning_profile makes the profile
    # on the first run and reuses it after that.
    get_provisioning_profile(api_key: api_key, app_identifier: APP_ID, team_id: TEAM_ID,
                             output_path: File.join(APPLE_DIR, "build"))
    profile = lane_context[SharedValues::SIGH_NAME]

    build_app(
      project: File.join(APPLE_DIR, PROJECT),
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_team_id: TEAM_ID,
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: { APP_ID => profile }
      },
      output_directory: File.join(APPLE_DIR, "build"),
      xcargs: "#{auth_args} CURRENT_PROJECT_VERSION=#{build_number}",
      export_xcargs: "-allowProvisioningUpdates"
    )
  end

  desc "Dry run: build a signed App Store .ipa in apple/build/. Uploads nothing."
  lane :build do
    archive_and_export(asc_api_key)
  end

  desc "Build a Release archive and upload it to TestFlight (internal testers)."
  lane :beta do
    api_key = asc_api_key
    archive_and_export(api_key)
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true
    )
  end
end
