      }
    },
    "Allow the camera for TripSplit in Settings, or paste the invite link instead.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'dan TripSplit için kameraya izin verin veya davet bağlantısını yapıştırın."
