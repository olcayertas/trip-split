      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bağlantıyı alan herkes grubu okuyabilir ve değiştirebilir. Yalnızca grup üyelerine gönderin."
          }
        }
      }
    },
    "Anyone who has this code or link can read and change the group. Show it only to members of the group.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
