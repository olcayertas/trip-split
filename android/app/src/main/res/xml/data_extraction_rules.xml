<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. The database holds the group keys and the op log. No backup and no
     device transfer may carry it: a copy on another phone would reuse this device id. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
