# Copy this file to android/keystore.properties. Never commit the copy.
# scripts/make-keystore.sh writes the copy for you.
# The Gradle release signingConfig reads these four keys. The passwords come
# from the environment (TRIPSPLIT_STORE_PASSWORD, TRIPSPLIT_KEY_PASSWORD) when
# the file has no password lines. scripts/release-android.sh sets them from the keychain.
storeFile=/Users/you/.tripsplit/tripsplit-release.jks
keyAlias=tripsplit
# storePassword=
# keyPassword=
